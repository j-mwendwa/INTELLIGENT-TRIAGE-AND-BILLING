# ─── Application ─────────────────────────────────────────────
APP_ENV=development           # development | staging | production
LOG_LEVEL=INFO

# ─── API Security ────────────────────────────────────────────
# Comma-separated list of valid API keys (minimum 32 chars each)
ALLOWED_API_KEYS=change-me-before-production-use

# Comma-separated list of allowed CORS origins (production only).
# Leave empty to block all cross-origin requests (not recommended).
# Example: https://my-app.azurecontainerapps.io,https://my-custom-domain.com
# CORS_ORIGINS=

# ─── Google Gemini ───────────────────────────────────────────
GOOGLE_API_KEY=your-google-gemini-api-key-here

# ─── Vector Store ────────────────────────────────────────────
VECTOR_BACKEND=chroma         # chroma | qdrant

# Chroma (dev default — local persistent or HTTP server)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=knowledge_base

# Qdrant (prod)
# QDRANT_URL=https://your-cluster-id.qdrant.io
# QDRANT_API_KEY=your-qdrant-cloud-api-key-here

# ─── Memory ──────────────────────────────────────────────────
# Optional Fernet key for encrypting entity memory at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MEMORY_ENCRYPTION_KEY=

# ─── Observability ───────────────────────────────────────────
# LangSmith tracing (opt-in)
# LANGSMITH_API_KEY=your-langsmith-api-key-here
# LANGSMITH_PROJECT=your-project-name

# ─── MCP ─────────────────────────────────────────────────────
MCP_ENABLED=true

# Tavily web search (opt-in)
# TAVILY_API_KEY=

# Postgres MCP (opt-in)
# DATABASE_URI=postgresql://user:pass@localhost:5432/triage_db
